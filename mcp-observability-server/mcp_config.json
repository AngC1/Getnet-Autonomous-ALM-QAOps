      "command": "python",
      "args": ["mcp-observability-server/server.py"],
      "env": {
        "GETNET_BASE_URL": "http://127.0.0.1:8080",
        "DYNATRACE_ENV_URL": "https://getnet-prod.live.dynatrace.com",
