        "CLOUDWATCH_LOG_GROUP": "/aws/ecs/getnet-card-blocker-svc",
        "PROMETHEUS_SCRAPE_URL": "http://127.0.0.1:8080/api/v1/observability/prometheus",
        "GETNET_ATM_BUCKET": "getnet-atm-incidents-pro",
